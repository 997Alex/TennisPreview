# TennisPreview Environment Variables
# Copy to .env and fill in your API keys

# TheOddsAPI (free tier: 500 requests/month)
# Get key at: https://the-odds-api.com/
THEODDSAPI_KEY=your_key_here

# API-Football / API-Sports (free tier: 100 requests/day)
# Get key at: https://api-sports.io/
API_FOOTBALL_KEY=your_key_here

# Betfair Exchange API (requires application)
# Get keys at: https://developer.betfair.com/
BETFAIR_APP_KEY=your_app_key_here
BETFAIR_SESSION_TOKEN=your_session_token_here

# Optional: Pinnacle API (requires partnership)
# PINNACLE_CLIENT_ID=your_client_id
# PINNACLE_CLIENT_SECRET=your_client_secret

# Database (if using PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:pass@localhost/tennispreview